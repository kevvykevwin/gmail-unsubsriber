# Gmail Unsubscribe Agent Configuration

# OAuth Configuration
GMAIL_UNSUB_CREDENTIALS_PATH=./credentials.json
GMAIL_UNSUB_TOKEN_PATH=./token.json

# Scanning Configuration
GMAIL_UNSUB_MAX_EMAILS_TO_SCAN=1000
GMAIL_UNSUB_SCAN_DAYS_BACK=90
GMAIL_UNSUB_BATCH_SIZE=100

# Rate Limiting
GMAIL_UNSUB_API_REQUESTS_PER_SECOND=10
GMAIL_UNSUB_MAX_RETRIES=5
GMAIL_UNSUB_BASE_BACKOFF_SECONDS=1.0

# Browser Automation
GMAIL_UNSUB_BROWSER_HEADLESS=true
GMAIL_UNSUB_BROWSER_TIMEOUT_MS=30000

# Storage
GMAIL_UNSUB_DATA_DIR=./data
